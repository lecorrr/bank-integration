<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.tkachuk</groupId>
        <artifactId>bank-integration</artifactId>
        <version>0.8.0</version>
    </parent>

    <artifactId>interbank-contract</artifactId>
    <name>interbank-contract</name>
    <description>What the two banks agree on: the RabbitMQ topology and the ISO 20022 messages</description>

    <dependencies>
        <!-- Only the topology types (Queue, Exchange, Binding). -->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- One package per message: the schemas reuse type names such as Document and GroupHeader91. -->
            <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>
                <version>${jaxb-maven-plugin.version}</version>
                <configuration>
                    <schemaDirectory>src/main/resources/xsd</schemaDirectory>
                    <!-- No episode file: nothing compiles against these schemas. -->
                    <episode>false</episode>
                </configuration>
                <executions>
                    <execution>
                        <id>pacs008</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaIncludes>
                                <include>pacs.008.001.08.xsd</include>
                            </schemaIncludes>
                            <generatePackage>dev.tkachuk.interbank.iso20022.pacs008</generatePackage>
                            <generateDirectory>${project.build.directory}/generated-sources/pacs008</generateDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pacs002</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaIncludes>
                                <include>pacs.002.001.10.xsd</include>
                            </schemaIncludes>
                            <generatePackage>dev.tkachuk.interbank.iso20022.pacs002</generatePackage>
                            <generateDirectory>${project.build.directory}/generated-sources/pacs002</generateDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>camt053</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaIncludes>
                                <include>camt.053.001.08.xsd</include>
                            </schemaIncludes>
                            <generatePackage>dev.tkachuk.interbank.iso20022.camt053</generatePackage>
                            <generateDirectory>${project.build.directory}/generated-sources/camt053</generateDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pacs028</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaIncludes>
                                <include>pacs.028.001.03.xsd</include>
                            </schemaIncludes>
                            <generatePackage>dev.tkachuk.interbank.iso20022.pacs028</generatePackage>
                            <generateDirectory>${project.build.directory}/generated-sources/pacs028</generateDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
