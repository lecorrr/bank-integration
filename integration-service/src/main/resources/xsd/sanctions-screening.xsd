<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sanctions screening service contract, version 1 (operation ScreenPayment, see the WSDL).
  The client classes are generated from this file, and both requests and responses are validated against it.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:bank-integration:sanctions-screening:1"
           targetNamespace="urn:bank-integration:sanctions-screening:1"
           elementFormDefault="qualified">

    <xs:element name="ScreenPaymentRequest">
        <xs:complexType>
            <xs:sequence>
                <!-- The payment's UETR, repeated in the response. -->
                <xs:element name="PaymentReference" type="Uuid"/>
                <xs:element name="Direction" type="Direction"/>
                <!-- Debtor, then creditor. -->
                <xs:element name="Party" type="Party" minOccurs="2" maxOccurs="2"/>
                <!-- Screened too: a listed name can appear in the free text. -->
                <xs:element name="RemittanceInformation" type="Max140Text"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="ScreenPaymentResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="PaymentReference" type="Uuid"/>
                <!-- The service's case id. -->
                <xs:element name="ScreeningId" type="Max35Text"/>
                <xs:element name="Outcome" type="Outcome"/>
                <!-- For a HIT: which field matched on which list. Never the matched name. -->
                <xs:element name="Match" type="Match" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="Party">
        <xs:sequence>
            <xs:element name="Role" type="PartyRole"/>
            <xs:element name="Name" type="Max140Text"/>
            <xs:element name="Iban" type="Iban"/>
            <xs:element name="Bic" type="Bic"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Match">
        <xs:sequence>
            <xs:element name="Field" type="ScreenedField"/>
            <!-- For example UA-NSDC, EU or UN. -->
            <xs:element name="ListName" type="Max35Text"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="Direction">
        <xs:restriction base="xs:string">
            <xs:enumeration value="OUTGOING"/>
            <xs:enumeration value="INCOMING"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Outcome">
        <xs:restriction base="xs:string">
            <xs:enumeration value="CLEAR"/>
            <xs:enumeration value="HIT"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PartyRole">
        <xs:restriction base="xs:string">
            <xs:enumeration value="DEBTOR"/>
            <xs:enumeration value="CREDITOR"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ScreenedField">
        <xs:restriction base="xs:string">
            <xs:enumeration value="DEBTOR"/>
            <xs:enumeration value="CREDITOR"/>
            <xs:enumeration value="REMITTANCE_INFORMATION"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- UETR: a lower-case version 4 UUID. -->
    <xs:simpleType name="Uuid">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ISO 20022 patterns, so anything a pacs.008 carries can be screened. -->
    <xs:simpleType name="Iban">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{2,2}[0-9]{2,2}[a-zA-Z0-9]{1,30}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Bic">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z0-9]{4,4}[A-Z]{2,2}[A-Z0-9]{2,2}([A-Z0-9]{3,3}){0,1}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Max35Text">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="35"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Max140Text">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="140"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
